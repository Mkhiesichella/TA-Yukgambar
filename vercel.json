{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "yukgambar-api": {
      "root": "yukgambar-api",
      "framework": "express"
    },
    "yukgambar-pwa": {
      "root": "yukgambar-pwa",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "yukgambar-api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "yukgambar-pwa" }
    }
  ]
}
